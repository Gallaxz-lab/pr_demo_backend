# Local demo default. For real deployment:
# DATABASE_URL=postgresql://user:password@localhost:5432/pr_racing
DATABASE_URL=sqlite:///./pr_racing.db

# Phase 1 — powers catalog-grounded AI Q&A. Leave blank to use the
# deterministic fallback (still works, just less conversational).
ANTHROPIC_API_KEY=

# Phase 2 — from your LINE Developers Console, once you create the OA.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

SECRET_KEY=change-me-in-production
